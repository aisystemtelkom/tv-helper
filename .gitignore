# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. Real values are secret; the template is not, and a fresh clone
# needs it to know a Gemini key is required before the app will start.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Leftover Ollama weights from before inference moved to the Gemini API. The
# rule stays so a stale 3.3GB ./models cannot be staged by accident; the
# directory itself is safe to delete.
/models

# Playwright MCP scratch output
/.playwright-mcp

# Real client documents used for testing the validator. These must NEVER be
# committed -- this repo is public. The client approving Google as a processor
# did not make their documents publishable. Keep test material here.
/documents
/test-docs

# OCR worker/core/language-data assets, vendored from node_modules by
# `pnpm vendor:ocr` (runs at prebuild). Regenerated build output -- several
# megabytes of binary that would otherwise land in every diff.
/public/tesseract/*
!/public/tesseract/.gitkeep

# Ad-hoc probe and scratch scripts. A class rule, not a list: one such script
# hard-coded an absolute path whose FILENAME carried a real LOP number and
# customer identifier, at the root of a public repo. /documents and /test-docs
# were ignored; nothing covered a file that merely names them.
/probe-*.mjs
/scratch-*.mjs

# Stray screenshots and mockups at the repo root. A class rule for the same
# reason as /probe-*.mjs: this repo is PUBLIC, a screenshot of the running app
# can carry a customer name in a rendered crop, and "git add -A" does not ask.
# Anything genuinely meant to be committed can be added with "git add -f".
/*.png
/mockups/
