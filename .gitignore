# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. Real values are secret; the template is not, and a fresh clone
# needs it to know a Gemini key is required before the app will start.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Leftover Ollama weights from before inference moved to the Gemini API. The
# rule stays so a stale 3.3GB ./models cannot be staged by accident; the
# directory itself is safe to delete.
/models

# Playwright MCP scratch output
/.playwright-mcp

# Real client documents used for testing the validator. These must NEVER be
# committed -- this repo is public. The client approving Google as a processor
# did not make their documents publishable. Keep test material here.
/documents
/test-docs
