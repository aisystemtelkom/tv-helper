# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local model weights -- 3.3GB, fetched by `pnpm setup`, never committed
/models

# Playwright MCP scratch output
/.playwright-mcp

# Real client documents used for testing the validator. These must NEVER be
# committed -- the client requires third-party minimization, and this repo is
# public. Keep test material here; it stays on the machine.
/documents
/test-docs

# OCR worker/core/language-data assets, vendored from node_modules by
# `pnpm vendor:ocr` (runs at prebuild). Regenerated build output -- several
# megabytes of binary that would otherwise land in every diff.
/public/tesseract/*
!/public/tesseract/.gitkeep
