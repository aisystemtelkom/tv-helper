# Gemini API key from https://aistudio.google.com/apikey. Required -- the app
# has no local fallback. Real values are secret: .env.local is gitignored,
# .env.example is committed and must never hold a real key.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Defaults to gemini-3.5-flash, chosen by measurement: the newer
# gemini-3.7-flash took 99-190s on a trivial vision call with intermittent 503s.
# Whatever you pick must be vision-capable, since reading scans is the product.
# MODEL_ID=gemini-3.5-flash

# --- Cost controls. Measured per page image; see AGENTS.md. ----------------

# LOW 274 | MEDIUM 528 | HIGH 1110 prompt tokens per image, a flat rate per
# tier regardless of pixel size. HIGH is the default
# because dense scans need it; drop to MEDIUM to halve input cost if your
# documents are large-print and accuracy holds up on real samples.
# GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH

# minimal 0 | low 40 | medium 194 | high 324 thought tokens, billed at the
# output rate. "low" is the default and already saves 79% against Gemini's own
# default of medium. Use "minimal" only if extraction quality holds.
# GEMINI_THINKING_LEVEL=low

# Runaway-generation guard, not a budget. The model will emit up to 65536.
# GEMINI_MAX_OUTPUT_TOKENS=4096
