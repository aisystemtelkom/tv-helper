# Gemini API key from https://aistudio.google.com/apikey. Required -- the app
# has no local fallback. Real values are secret: .env.local is gitignored,
# .env.example is committed and must never hold a real key.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Defaults to gemini-3.5-flash, chosen by measurement: the newer
# gemini-3.7-flash took 99-190s on a trivial vision call with intermittent 503s.
# Whatever you pick must be vision-capable, since reading scans is the product.
# MODEL_ID=gemini-3.5-flash

# --- Sign-in. Required to open the app in a browser. -----------------------
#
# Without these, `pnpm dev` serves a sign-in page that cannot complete: the
# button is there, the OAuth redirect fails, and you land back on /signin with
# ?error=Configuration. That is the intended failure -- there is no anonymous
# mode outside the one-shot bootstrap deploy described in
# docs/runbook-deploy.md -- but it looks like a bug if you were not expecting
# it. `pnpm test`, `pnpm generate` and `pnpm smoke` need none of this.

# Signs the session JWT. Any high-entropy string; `openssl rand -base64 32` or
# `npx auth secret`. Changing it signs everyone out.
AUTH_SECRET=

# Google OAuth Web application client, from Google Cloud console ->
# APIs & Services -> Credentials. For local work create a SEPARATE client whose
# authorized redirect URI is exactly:
#   http://localhost:3000/api/auth/callback/google
# Setting AUTH_GOOGLE_ID is also the interlock that permanently disables
# AUTH_DISABLED, so a forgotten bootstrap flag cannot un-gate a real install.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The canonical URL this app is reached at. Auth.js builds the OAuth callback
# from it. On Cloud Run set it to the service URL; locally it is the dev server.
AUTH_URL=http://localhost:3000

# Firestore holds the allowlist. Locally it authenticates through
# `gcloud auth application-default login`; without that every lookup returns
# lookup-failed and only the hardcoded bootstrap owner gets in, which is a fair
# simulation of an outage. Both of these are optional overrides.
# ALLOWLIST_COLLECTION=allowlist
# ALLOWLIST_TIMEOUT_MS=5000

# Serves every request WITHOUT authentication. It is honoured only while
# AUTH_GOOGLE_ID is empty, and only the exact string "true". This exists for one
# thing: the first Cloud Run deploy, which has to mint the service URL that the
# OAuth client's redirect URI needs. Do not use it to skip local setup.
# AUTH_DISABLED=true

# --- Cost controls. Measured per page image; see AGENTS.md. ----------------

# LOW 274 | MEDIUM 528 | HIGH 1110 prompt tokens per image, a flat rate per
# tier regardless of pixel size. HIGH is the default
# because dense scans need it; drop to MEDIUM to halve input cost if your
# documents are large-print and accuracy holds up on real samples.
# GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH

# minimal 0 | low 40 | medium 194 | high 324 thought tokens, billed at the
# output rate. "low" is the default and already saves 79% against Gemini's own
# default of medium. Use "minimal" only if extraction quality holds.
# GEMINI_THINKING_LEVEL=low

# Runaway-generation guard, not a budget. The model will emit up to 65536.
# GEMINI_MAX_OUTPUT_TOKENS=4096
